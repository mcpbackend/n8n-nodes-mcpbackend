[
  {
    "displayName": "Operation",
    "name": "operation",
    "type": "options",
    "noDataExpression": true,
    "options": [
      {
        "name": "Add Column",
        "value": "add_column",
        "description": "Add a column to an existing table. NOT NULL columns require a defaultValue",
        "action": "Add Column in MCPBackend"
      },
      {
        "name": "Add Team Member",
        "value": "add_team_member",
        "description": "Add a team member by email with full access or access to selected projects. Sends an invitation email",
        "action": "Add Team Member in MCPBackend"
      },
      {
        "name": "Create API Key",
        "value": "create_api_key",
        "description": "Create a server-side API key for a project's data API. Empty permissions = full access; otherwise per-table {table, read, create, update, delete}. Returns the secret once. The secret grants server-side access and is unsuitable for public client code",
        "action": "Create API Key in MCPBackend"
      },
      {
        "name": "Create Project",
        "value": "create_project",
        "description": "Create a new project. Provisions a dedicated database and returns the project id plus canonical application API URLs",
        "action": "Create Project in MCPBackend"
      },
      {
        "name": "Create Table",
        "value": "create_table",
        "description": "Create a table in a project's database. An integer primary key `id` is added automatically unless you define your own primary key or an `id` column",
        "action": "Create Table in MCPBackend"
      },
      {
        "name": "Create Webhook",
        "value": "create_webhook",
        "description": "Create a webhook that POSTs on row changes. events like ['posts.created','*.deleted','*']. Returns the signing secret once",
        "action": "Create Webhook in MCPBackend"
      },
      {
        "name": "Get Project",
        "value": "get_project",
        "description": "Get an existing project by id, including its canonical data-plane API URLs",
        "action": "Get Project in MCPBackend"
      },
      {
        "name": "Get Project API",
        "value": "get_project_api",
        "description": "Get the exact runtime API contract for an existing or newly created project. Returns canonical route templates, security guidance, and the generated OpenAPI document",
        "action": "Get Project API in MCPBackend"
      },
      {
        "name": "Get Schema",
        "value": "get_schema",
        "description": "Get the tables/columns schema of a project. This describes the storage schema",
        "action": "Get Schema in MCPBackend"
      },
      {
        "name": "Get Usage",
        "value": "get_usage",
        "description": "Get the current-month usage and plan limits for a project",
        "action": "Get Usage in MCPBackend"
      },
      {
        "name": "List Projects",
        "value": "list_projects",
        "description": "List the caller's McpBackend projects. Each project includes canonical data-plane API URLs",
        "action": "List Projects in MCPBackend"
      },
      {
        "name": "List Team Members",
        "value": "list_team_members",
        "description": "List team members, their access scope, and projects owned by the caller for assignment",
        "action": "List Team Members in MCPBackend"
      },
      {
        "name": "Remove Team Member",
        "value": "remove_team_member",
        "description": "Remove a member from the caller's team and revoke all shared project access",
        "action": "Remove Team Member in MCPBackend"
      },
      {
        "name": "Set Auth Enabled",
        "value": "set_auth_enabled",
        "description": "Enable or disable end-user (email/password) authentication for a project",
        "action": "Set Auth Enabled in MCPBackend"
      },
      {
        "name": "Set Table RLS",
        "value": "set_table_rls",
        "description": "Set row-level security for a table. Modes: public (anyone), authenticated (any logged-in user), owner (only the user's own rows). 'owner' adds an owner column automatically",
        "action": "Set Table RLS in MCPBackend"
      },
      {
        "name": "Update Team Member",
        "value": "update_team_member",
        "description": "Change a team member between full access and selected-project access",
        "action": "Update Team Member in MCPBackend"
      }
    ],
    "default": "list_projects"
  },
